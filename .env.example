PORT=3000
# development lokalnie; na serwerze production (wlacza secure cookies - wymaga HTTPS)
NODE_ENV=development
SESSION_SECRET=change-me-to-a-long-random-string
DB_PATH=./data/bdik.sqlite

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# musi byc identyczny (co do znaku) z Authorized redirect URI w Google Cloud Console
# prod: https://twoja-domena.pl/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# --- Stripe (platnosci za eksport) ---
# Klucz ograniczony (rk_...) wystarczy: uprawnienia Checkout Sessions [write] + PaymentIntents [read].
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Lokalnie: `stripe listen --forward-to localhost:3000/webhooks/stripe` wypisze whsec_...
# Na produkcji: Dashboard -> Developers -> Webhooks -> endpoint /webhooks/stripe
STRIPE_WEBHOOK_SECRET=
# Bezwzgledny adres strony - Stripe wraca tu po platnosci (return_url).
PUBLIC_BASE_URL=http://localhost:3000
# Ceny w cenniku sa NETTO - VAT 23% dolicza Stripe przez obiekt TaxRate.
# Zostaw puste, a aplikacja utworzy stawke sama (i zapamieta ja). Mozesz tez
# wskazac gotowa stawke z Dashboardu (Product catalog -> Tax rates): txr_...
STRIPE_TAX_RATE_ID=

# --- Dane sprzedawcy (stopka, regulamin, polityka prywatnosci, e-mail, faktura) ---
# Wymagane na produkcji - bez kompletu (nazwa+adres+NIP+email) stopka pokaze braki.
SELLER_NAME=Straz Rytmiczna Karol Konop
SELLER_ADDRESS=
SELLER_NIP=5932472450
SELLER_REGON=
SELLER_EMAIL=karol.konop@gmail.com

# --- E-mail potwierdzajacy zakup (trwaly nosnik, SMTP) ---
# Bez SMTP_HOST wysylka jest pomijana (ostrzezenie w logu), aplikacja dziala.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Adres nadawcy; domyslnie SMTP_USER.
MAIL_FROM=
# Kod promocyjny Stripe (promotion code z Dashboardu) doklejany do e-maila z
# probka dla leadow; puste = domyslny DISCOUNT20 (lib/mailer.js).
LEAD_PROMO_CODE=

# --- Administracja ---
# Adresy z uprawnieniami admina (panel /admin/orders, eksport administracyjny).
# Rozdzielone przecinkami. Dziala takze konto z rola 'admin' w bazie.
ADMIN_EMAILS=karol.konop@gmail.com
# Katalog na kopie zapasowe wygenerowanych plikow (poza public/, niepubliczny).
EXPORT_BACKUP_DIR=./data/exports
