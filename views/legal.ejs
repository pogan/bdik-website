<%
  // Tytuł strony wyprowadzamy z nazwy dołączanego dokumentu, żeby trasy nie
  // musiały go przekazywać osobno.
  const docTitle = document.includes('polityka') ? 'Polityka prywatności' : 'Regulamin';
%>
<!doctype html>
<html lang="pl">
<head>
  <%- include('partials/head', { title: `${docTitle} - Baza Instytucji Kultury` }) %>
</head>
<body>
  <%- include('partials/nav', { user: typeof user !== 'undefined' ? user : null }) %>

  <main class="container pb-5">
    <div class="row justify-content-center">
      <div class="col-12 col-lg-9">
        <article class="legal-doc bg-white border rounded p-4 p-md-5">
          <%- include(document) %>
        </article>
        <p class="mt-3">
          <a href="/baza" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Wróć do bazy</a>
        </p>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>

  <script src="/vendor/bootstrap/bootstrap.bundle.min.js"></script>
  <script src="/js/cookies.js"></script>
</body>
</html>
