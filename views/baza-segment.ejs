<!doctype html>
<html lang="pl">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/nav', { user: typeof user !== 'undefined' ? user : null }) %>

  <header class="hero">
    <div class="container hero-inner">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
          <% breadcrumb.forEach((item, i) => { %>
            <% if (i < breadcrumb.length - 1) { %>
              <li class="breadcrumb-item"><a href="<%= item.url %>"><%= item.name %></a></li>
            <% } else { %>
              <li class="breadcrumb-item active" aria-current="page"><%= item.name %></li>
            <% } %>
          <% }) %>
        </ol>
      </nav>
      <div class="row">
        <div class="col-lg-9">
          <h1><%= h1 %></h1>
          <p class="hero-lead">
            <%- leadHtml %>
            <% if (topLocalities.length) { %>
              Najwięcej instytucji jest w miejscowościach:
              <%= topLocalities.map((l) => `${l.label} (${l.count})`).join(', ') %>.
            <% } %>
          </p>
          <% if (coverage.total) { %>
            <p class="mb-2">
              Telefon ma <strong><%= coveragePct.phone %>%</strong> z nich, e-mail <strong><%= coveragePct.email %>%</strong>, a stronę WWW <strong><%= coveragePct.website %>%</strong>
              (w całej bazie: <%= coveragePctAll.phone %>% / <%= coveragePctAll.email %>% / <%= coveragePctAll.website %>%).
            </p>
          <% } %>
          <p class="text-secondary small mb-3">Dane w stanie z dnia <%= dataUpdatedAt %>.</p>
          <div class="hero-cta">
            <a href="#tool" class="btn btn-hero btn-lg"><i class="bi bi-search me-2"></i>Przeglądaj i eksportuj</a>
            <a href="/baza#cennik" class="btn btn-hero-ghost btn-lg">Cennik</a>
          </div>
        </div>
      </div>
    </div>
  </header>

  <% breakdowns.forEach((bd) => { %>
    <section class="container py-4">
      <h2 class="h5 mb-3"><%= bd.heading %></h2>
      <div class="table-shell table-responsive">
        <table class="table table-sm align-middle mb-0">
          <thead>
            <tr><th>Kategoria</th><th class="text-end">Liczba instytucji</th></tr>
          </thead>
          <tbody>
            <% bd.rows.forEach((r) => { %>
              <tr>
                <td><% if (r.href) { %><a href="<%= r.href %>"><%= r.label %></a><% } else { %><%= r.label %><% } %></td>
                <td class="text-end"><%= r.count %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>
  <% }) %>

  <% if (sample && sample.length) { %>
  <section class="container py-4">
    <h2 class="h5 mb-3">Przykładowe instytucje</h2>
    <div class="table-shell table-responsive">
      <table class="table table-sm table-hover align-middle mb-0">
        <thead>
          <tr><th>Nazwa</th><th>Województwo</th><th>Powiat</th><th>Miejscowość</th></tr>
        </thead>
        <tbody>
          <% sample.forEach((row) => { %>
            <tr>
              <td><%= row.name %></td>
              <td><%= row.voivodeship %></td>
              <td><%= row.county %></td>
              <td><%= row.locality %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% if (total > sample.length) { %>
      <p class="text-secondary small mt-2 mb-0">
        To pierwsze <%= sample.length %> z <%= total %> instytucji (nazwa i lokalizacja są zawsze bezpłatne) —
        pełną listę z filtrami, danymi kontaktowymi i eksportem znajdziesz niżej.
      </p>
    <% } %>
  </section>
  <% } %>

  <%- include('partials/tool') %>

  <% if (listGroups.length) { %>
  <section class="container py-4 segment-list">
    <h2 class="h5 mb-1"><%= listHeading %></h2>
    <p class="text-secondary small mb-3">
      Nazwy i adresy są bezpłatne. Ikony pokazują, które dane kontaktowe są w bazie:
      <i class="bi bi-telephone" aria-hidden="true"></i> telefon,
      <i class="bi bi-envelope" aria-hidden="true"></i> e-mail,
      <i class="bi bi-globe" aria-hidden="true"></i> strona WWW.
    </p>
    <div class="segment-list-groups">
      <% listGroups.forEach((g) => { %>
        <div class="segment-list-group">
          <h3 class="h6 mb-1"><% if (g.href) { %><a href="<%= g.href %>"><%= g.label %></a><% } else { %><%= g.label %><% } %>
            <span class="text-secondary fw-normal small">(<%= g.items.length %>)</span></h3>
          <ul class="list-unstyled mb-3">
            <% g.items.forEach((it) => { %>
              <li class="mb-1">
                <span class="fw-semibold"><%= it.name %></span>
                <span class="segment-contact text-secondary">
                  <% if (it.hasPhone) { %><i class="bi bi-telephone" role="img" aria-label="telefon w bazie" title="telefon w bazie"></i><% } %>
                  <% if (it.hasEmail) { %><i class="bi bi-envelope" role="img" aria-label="e-mail w bazie" title="e-mail w bazie"></i><% } %>
                  <% if (it.hasWebsite) { %><i class="bi bi-globe" role="img" aria-label="strona WWW w bazie" title="strona WWW w bazie"></i><% } %>
                </span>
                <br><span class="small text-secondary"><%= it.address %></span>
              </li>
            <% }) %>
          </ul>
        </div>
      <% }) %>
    </div>
  </section>
  <% } %>

  <section class="container py-3">
    <div class="segment-cta p-3 rounded border">
      <p class="mb-2">
        <strong>Pełne dane kontaktowe</strong> (telefon, e-mail, WWW) pobierzesz w eksporcie CSV, XLSX lub PDF.
        Płacisz jednorazowo i tylko za rekordy z telefonem lub e-mailem — od <%= cennik.tiers[cennik.tiers.length - 1].perRowLabel %>
        do <%= cennik.tiers[0].perRowLabel %> netto za rekord, bez abonamentu i rejestracji.
      </p>
      <a href="#tool" class="btn btn-primary btn-sm me-2">Ustaw filtry i sprawdź cenę</a>
      <a href="/baza#cennik" class="btn btn-outline-secondary btn-sm">Pełny cennik</a>
    </div>
  </section>

  <p class="container text-secondary small">
    Masz pytania dotyczące zakupu i licencji? Zobacz <a href="/faq">najczęstsze pytania</a>.
  </p>

  <%- include('partials/browse-links', {
    heading: 'Zobacz też',
    anchorId: null,
    voivodeshipsList,
    institutionTypes,
    excludeVoivodeshipSlug: related.excludeVoivodeshipSlug || null,
    excludeTypeSlug: related.excludeTypeSlug || null,
  }) %>

  <%- include('partials/payment-modal') %>

  <%- include('partials/footer') %>

  <script src="/vendor/bootstrap/bootstrap.bundle.min.js"></script>
  <script src="https://js.stripe.com/v3/"></script>
  <script>
    window.BDIK_STRIPE = {
      publishableKey: <%- JSON.stringify(stripePublishableKey || '') %>,
      configured: <%- JSON.stringify(Boolean(stripeConfigured)) %>,
    };
    // Null dla wszystkich poza administratorem - table.js renderuje wtedy
    // dotychczasowy, wąski zestaw kolumn.
    window.BDIK_ADMIN_VIEW = <%- JSON.stringify(adminView || null) %>;
    // Wstępne zawężenie narzędzia do tego segmentu (patrz public/js/table.js) -
    // pole filtru zostaje aktywne, to punkt wejścia, nie twardy limit.
    window.BDIK_INITIAL_FILTERS = <%- JSON.stringify(initialFilters || {}) %>;
  </script>
  <script src="/js/checkout.js"></script>
  <script src="/js/table.js"></script>
  <script src="/js/cookies.js"></script>
</body>
</html>
