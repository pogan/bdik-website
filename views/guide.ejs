<!doctype html>
<html lang="pl">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/nav', { user: typeof user !== 'undefined' ? user : null }) %>

  <main class="container pb-5">
    <div class="row justify-content-center">
      <div class="col-12 col-lg-9">
        <nav aria-label="breadcrumb">
          <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/baza">Baza</a></li>
            <li class="breadcrumb-item"><a href="/poradniki">Poradniki</a></li>
            <li class="breadcrumb-item active" aria-current="page"><%= guide.title %></li>
          </ol>
        </nav>

        <article class="legal-doc bg-white border rounded p-4 p-md-5">
          <h1 class="h3 mb-2"><%= guide.title %></h1>
          <p class="text-secondary small mb-4">
            <% if (guide.published !== guide.updated) { %>
              Opublikowano <%= guide.published %>, zaktualizowano <%= guide.updated %>.
            <% } else { %>
              Opublikowano <%= guide.published %>.
            <% } %>
          </p>
          <%- include(guide.view) %>

          <hr class="my-4">
          <p class="mb-0">
            <a href="/baza" class="btn btn-primary btn-sm">Przeglądaj bazę instytucji kultury</a>
            <a href="/poradniki" class="btn btn-outline-secondary btn-sm ms-1">Więcej poradników</a>
          </p>
        </article>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>

  <script src="/vendor/bootstrap/bootstrap.bundle.min.js"></script>
  <script src="/js/cookies.js"></script>
</body>
</html>
