<!doctype html>
<html lang="pl">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/nav', { user: typeof user !== 'undefined' ? user : null }) %>

  <header class="hero">
    <div class="container hero-inner">
      <div class="row">
        <div class="col-lg-9">
          <span class="hero-eyebrow"><span class="dot"></span>Dla artystów, zespołów i animatorów kultury</span>
          <h1>Dotrzyj do instytucji kultury, które <span class="accent">szukają Twojej sztuki</span>.</h1>
          <p class="hero-lead">
            Ponad 2&nbsp;200 domów kultury, bibliotek i centrów kultury w jednej,
            uporządkowanej bazie. Filtruj po województwie, sprawdź dane kontaktowe
            i wyeksportuj gotową listę pod trasę koncertową, wystawę lub warsztaty.
          </p>
          <div class="hero-cta">
            <a href="#tool" class="btn btn-hero btn-lg"><i class="bi bi-search me-2"></i>Przeglądaj bazę</a>
            <a href="#jak" class="btn btn-hero-ghost btn-lg">Jak to działa</a>
            <a href="#cennik" class="btn btn-hero-ghost btn-lg">Cennik</a>
          </div>
          <div class="hero-stats">
            <div class="stat"><div class="num">2&nbsp;200+</div><div class="lbl">instytucji kultury</div></div>
            <div class="stat"><div class="num">16</div><div class="lbl">województw</div></div>
            <div class="stat"><div class="num">CSV · XLSX · PDF</div><div class="lbl">formaty eksportu</div></div>
            <div class="stat"><div class="num"><%= dataUpdatedAt %></div><div class="lbl">ostatnia aktualizacja danych</div></div>
          </div>
          <div class="hero-trust">
            <span class="item"><i class="bi bi-patch-check-fill"></i>Dane z publicznych rejestrów</span>
            <span class="item"><i class="bi bi-tag-fill"></i>Jednorazowo, od <%= cennik.minGrossLabel %> brutto</span>
            <span class="item"><i class="bi bi-download"></i>Eksport jednym kliknięciem</span>
            <span class="item"><i class="bi bi-shield-lock-fill"></i>Płatność BLIK · Przelewy24 · karta</span>
          </div>
        </div>
      </div>
    </div>
  </header>

  <section class="steps" id="jak">
    <div class="container">
      <div class="row">
        <div class="col-12 col-md-4">
          <div class="step">
            <div class="idx">1</div>
            <div><div class="st-title">Filtruj</div><p class="st-desc">Zawęź bazę po województwie, powiecie, gminie i miejscowości albo po prostu wpisz nazwę.</p></div>
          </div>
        </div>
        <div class="col-12 col-md-4">
          <div class="step">
            <div class="idx">2</div>
            <div><div class="st-title">Sprawdź zasięg</div><p class="st-desc">Od razu widzisz, ile instytucji z Twojego wyboru ma telefon, e-mail i stronę WWW.</p></div>
          </div>
        </div>
        <div class="col-12 col-md-4">
          <div class="step">
            <div class="idx">3</div>
            <div><div class="st-title">Eksportuj</div><p class="st-desc">Pobierz listę z pełnymi danymi kontaktowymi w CSV, XLSX lub PDF — płacisz tylko za to, co wybierzesz.</p></div>
          </div>
        </div>
      </div>
      <div class="step step-sample">
        <div class="idx">4</div>
        <div class="w-100">
          <div class="step-sample-body">
            <div>
              <div class="st-title">Pobierz przykładową listę</div>
              <p class="st-desc">Zobacz, jak wygląda plik przed zakupem: 16 prawdziwych instytucji — po jednej z każdego województwa, z kompletem danych kontaktowych. Próbka jest w PDF; eksport w CSV i XLSX zawiera dodatkowo m.in. NIP, PKD i daty.</p>
            </div>
            <a class="btn btn-primary" id="sample-download" href="/pliki/przykladowa-lista-instytucji-kultury.pdf" download>Pobierz przykład (PDF)</a>
          </div>
          <!-- Opcjonalny lead: próbka jest dostępna od ręki powyżej; e-mail to
               dodatkowa droga (z kodem rabatowym), nie bramka. -->
          <form id="lead-form" class="lead-capture mt-3" novalidate>
            <div class="small fw-semibold">Wolisz na e-mail? Wyślemy Ci próbkę i kod rabatowy na pierwszy eksport.</div>
            <div class="d-flex flex-wrap gap-2 mt-2">
              <input type="email" class="form-control form-control-sm" id="lead-email"
                     placeholder="twoj@adres.pl" autocomplete="email" style="max-width:260px" required>
              <button type="submit" class="btn btn-outline-primary btn-sm" id="lead-submit">Wyślij próbkę</button>
            </div>
            <div class="form-check mt-2">
              <input class="form-check-input" type="checkbox" id="lead-consent">
              <label class="form-check-label lead-consent-label" for="lead-consent">
                Chcę otrzymać na podany adres próbkę oraz pojedyncze wiadomości o bazie (np. kod
                rabatowy, informacja o aktualizacji danych). Zgodę mogę wycofać w każdej chwili —
                <a href="/polityka-prywatnosci" target="_blank" rel="noopener">Polityka prywatności</a>.
              </label>
            </div>
            <div class="small mt-1 d-none" id="lead-status"></div>
          </form>
        </div>
      </div>
    </div>
  </section>

  <%- include('partials/pricing') %>

  <%- include('partials/tool') %>

  <%- include('partials/browse-links', { heading: 'Przeglądaj bazę według regionu i typu instytucji', anchorId: 'regiony', voivodeshipsList, institutionTypes, excludeVoivodeshipSlug: null, excludeTypeSlug: null }) %>

  <%- include('partials/faq') %>

  <%- include('partials/payment-modal') %>

  <%- include('partials/footer') %>

  <script src="/vendor/bootstrap/bootstrap.bundle.min.js"></script>
  <script src="https://js.stripe.com/v3/"></script>
  <script>
    window.BDIK_STRIPE = {
      publishableKey: <%- JSON.stringify(stripePublishableKey || '') %>,
      configured: <%- JSON.stringify(Boolean(stripeConfigured)) %>,
    };
    // Null dla wszystkich poza administratorem - table.js renderuje wtedy
    // dotychczasowy, wąski zestaw kolumn.
    window.BDIK_ADMIN_VIEW = <%- JSON.stringify(adminView || null) %>;
  </script>
  <script src="/js/checkout.js"></script>
  <script src="/js/table.js"></script>
  <script src="/js/cookies.js"></script>
</body>
</html>
