<!doctype html>
<html lang="pl">
<head>
  <%- include('partials/head', { title: 'Baza Danych Instytucji Kultury' }) %>
</head>
<body>
  <%- include('partials/nav', { user: typeof user !== 'undefined' ? user : null }) %>

  <header class="hero">
    <div class="container hero-inner">
      <div class="row">
        <div class="col-lg-9">
          <span class="hero-eyebrow"><span class="dot"></span>Dla artystów, zespołów i animatorów kultury</span>
          <h1>Dotrzyj do instytucji kultury, które <span class="accent">szukają Twojej sztuki</span>.</h1>
          <p class="hero-lead">
            Ponad 2&nbsp;200 domów kultury, bibliotek i centrów kultury w jednej,
            uporządkowanej bazie. Filtruj po regionie, sprawdź dane kontaktowe
            i wyeksportuj gotową listę pod trasę koncertową, wystawę lub warsztaty.
          </p>
          <div class="hero-cta">
            <a href="#tool" class="btn btn-hero btn-lg"><i class="bi bi-search me-2"></i>Przeglądaj bazę</a>
            <a href="#jak" class="btn btn-hero-ghost btn-lg">Jak to działa</a>
          </div>
          <div class="hero-stats">
            <div class="stat"><div class="num">2&nbsp;200+</div><div class="lbl">instytucji kultury</div></div>
            <div class="stat"><div class="num">16</div><div class="lbl">województw</div></div>
            <div class="stat"><div class="num">CSV · XLSX · PDF</div><div class="lbl">formaty eksportu</div></div>
          </div>
          <div class="hero-trust">
            <span class="item"><i class="bi bi-patch-check-fill"></i>Dane z publicznych rejestrów</span>
            <span class="item"><i class="bi bi-download"></i>Eksport jednym kliknięciem</span>
            <span class="item"><i class="bi bi-shield-lock-fill"></i>Płatność BLIK · Przelewy24 · karta</span>
          </div>
        </div>
      </div>
    </div>
  </header>

  <section class="steps" id="jak">
    <div class="container">
      <div class="row">
        <div class="col-12 col-md-4">
          <div class="step">
            <div class="idx">1</div>
            <div><div class="st-title">Filtruj</div><p class="st-desc">Zawęź bazę po województwie, powiecie, gminie i miejscowości albo po prostu wpisz nazwę.</p></div>
          </div>
        </div>
        <div class="col-12 col-md-4">
          <div class="step">
            <div class="idx">2</div>
            <div><div class="st-title">Sprawdź zasięg</div><p class="st-desc">Od razu widzisz, ile instytucji z Twojego wyboru ma telefon, e-mail i stronę WWW.</p></div>
          </div>
        </div>
        <div class="col-12 col-md-4">
          <div class="step">
            <div class="idx">3</div>
            <div><div class="st-title">Eksportuj</div><p class="st-desc">Pobierz listę z pełnymi danymi kontaktowymi w CSV, XLSX lub PDF — płacisz tylko za to, co wybierzesz.</p></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <main class="container py-5" id="tool">
    <div class="tool-header d-flex flex-wrap justify-content-between align-items-end mb-3 gap-3">
      <div>
        <h2>Przeglądaj bazę</h2>
        <p class="small mb-0" id="result-count">Ładowanie danych…</p>
      </div>
      <div class="text-end">
        <div class="btn-group" id="export-buttons">
          <button type="button" class="btn btn-outline-secondary btn-sm" data-format="csv"><i class="bi bi-filetype-csv me-1"></i>CSV</button>
          <button type="button" class="btn btn-outline-secondary btn-sm" data-format="xlsx"><i class="bi bi-file-earmark-excel me-1"></i>XLSX</button>
          <button type="button" class="btn btn-outline-secondary btn-sm" data-format="pdf"><i class="bi bi-file-earmark-pdf me-1"></i>PDF</button>
        </div>
        <div class="export-hint small mt-2"><i class="bi bi-unlock me-1"></i>Pełne dane kontaktowe odblokowujesz eksportem</div>
      </div>
    </div>

    <div class="filters-card p-3 mb-3">
      <div class="row g-2">
          <div class="col-6 col-md-3">
            <label class="form-label small text-secondary mb-1">Województwo</label>
            <select class="form-select form-select-sm" id="f-voivodeship">
              <option value="">Wszystkie</option>
            </select>
          </div>
          <div class="col-6 col-md-3">
            <label class="form-label small text-secondary mb-1">Powiat</label>
            <select class="form-select form-select-sm" id="f-county">
              <option value="">Wszystkie</option>
            </select>
          </div>
          <div class="col-6 col-md-3">
            <label class="form-label small text-secondary mb-1">Gmina</label>
            <select class="form-select form-select-sm" id="f-commune">
              <option value="">Wszystkie</option>
            </select>
          </div>
          <div class="col-6 col-md-3">
            <label class="form-label small text-secondary mb-1">Miejscowość</label>
            <select class="form-select form-select-sm" id="f-locality">
              <option value="">Wszystkie</option>
            </select>
          </div>
          <div class="col-12">
            <label class="form-label small text-secondary mb-1">Szukaj po nazwie</label>
            <div class="input-group input-group-sm">
              <span class="input-group-text"><i class="bi bi-search"></i></span>
              <input type="text" class="form-control" id="f-search" placeholder="np. biblioteka, dom kultury...">
              <button class="btn btn-outline-secondary" type="button" id="f-reset">Wyczyść filtry</button>
            </div>
          </div>
        </div>
      </div>

    <div class="table-shell table-responsive">
      <table class="table table-hover align-middle mb-0" id="results-table">
        <thead>
          <tr id="table-head"></tr>
        </thead>
        <tbody id="table-body">
          <tr><td class="text-center text-secondary py-4">Ładowanie…</td></tr>
        </tbody>
      </table>
    </div>

    <nav class="d-flex justify-content-between align-items-center mt-3">
      <div class="text-secondary small" id="page-info"></div>
      <ul class="pagination pagination-sm mb-0" id="pagination"></ul>
    </nav>
  </main>

  <div class="modal fade" id="payment-modal" tabindex="-1" aria-labelledby="payment-modal-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="payment-modal-title">Pobierz eksport</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zamknij"></button>
        </div>
        <div class="modal-body">
          <div class="checkout-summary p-3 mb-3">
            <div class="fw-semibold" id="checkout-summary-title">Przygotowywanie…</div>
            <div class="text-secondary small mb-3" id="checkout-summary-filters"></div>
            <!-- Pokrycie danych kontaktowych w wybranym zakresie (ile rekordów ma
                 telefon, e-mail, WWW). Wypełnia checkout.js z danych tabeli. -->
            <div class="d-none mb-3" id="checkout-coverage">
              <div class="text-secondary small mb-1">Dane kontaktowe w tym zakresie:</div>
              <div class="d-flex flex-wrap gap-2">
                <span class="badge rounded-pill d-none" id="cov-phone"></span>
                <span class="badge rounded-pill d-none" id="cov-email"></span>
                <span class="badge rounded-pill d-none" id="cov-website"></span>
              </div>
            </div>
            <dl class="mb-0 small">
              <div class="d-flex justify-content-between">
                <dt class="fw-normal text-secondary">Liczba rekordów</dt>
                <dd class="mb-1 text-nowrap" id="sum-rows">—</dd>
              </div>
              <div class="d-flex justify-content-between">
                <dt class="fw-normal text-secondary">Cena za rekord (śr.)</dt>
                <dd class="mb-1 text-nowrap" id="sum-perrow">—</dd>
              </div>
              <div class="d-flex justify-content-between">
                <dt class="fw-normal text-secondary">Wartość netto</dt>
                <dd class="mb-1 text-nowrap" id="sum-net">—</dd>
              </div>
              <div class="d-flex justify-content-between">
                <dt class="fw-normal text-secondary" id="sum-vat-label">VAT (23%)</dt>
                <dd class="mb-1 text-nowrap" id="sum-vat">—</dd>
              </div>
              <hr class="my-2">
              <div class="d-flex justify-content-between align-items-baseline">
                <dt class="fs-5">Do zapłaty (brutto)</dt>
                <dd class="mb-0 fs-5 fw-semibold text-nowrap" id="sum-gross">—</dd>
              </div>
            </dl>
          </div>

          <div id="checkout-error" class="alert alert-danger d-none" role="alert"></div>

          <!-- Zgody wymagane przed płatnością (art. 8 UŚUDE + art. 38 pkt 13 UPK).
               Dopóki oba pola nie są zaznaczone, nie zakładamy zamówienia ani nie
               montujemy formularza Stripe. -->
          <div id="checkout-consents">
            <div class="alert alert-info small mb-3">
              <i class="bi bi-info-circle me-1"></i>Dane pochodzą z publicznych rejestrów (m.in. KRS)
              i ręcznych uzupełnień. Nie gwarantujemy ich kompletności ani zgodności ze stanem
              faktycznym — część rekordów może nie mieć telefonu, e-maila lub WWW (widać to przy
              filtrowaniu). Zakup podlega <a href="/regulamin" target="_blank" rel="noopener">licencji</a>:
              wyłącznie do użytku własnego, bez edycji, upubliczniania i odsprzedaży.
            </div>
            <div class="form-check mb-2">
              <input class="form-check-input" type="checkbox" id="consent-terms">
              <label class="form-check-label small" for="consent-terms">
                Akceptuję <a href="/regulamin" target="_blank" rel="noopener">Regulamin</a> oraz
                <a href="/polityka-prywatnosci" target="_blank" rel="noopener">Politykę prywatności</a>.
              </label>
            </div>
            <div class="form-check mb-3">
              <input class="form-check-input" type="checkbox" id="consent-withdrawal">
              <label class="form-check-label small" for="consent-withdrawal">
                Żądam dostarczenia treści cyfrowej (pliku) niezwłocznie po opłaceniu i przyjmuję do
                wiadomości, że z chwilą rozpoczęcia pobierania <strong>tracę prawo odstąpienia</strong>
                od umowy.
              </label>
            </div>
            <div class="d-grid">
              <button type="button" class="btn btn-primary" id="consent-continue" disabled>
                Przejdź do płatności
              </button>
            </div>
          </div>

          <!-- Widok płatności -->
          <div id="checkout-pay" class="d-none">
            <div id="checkout-loading" class="text-center text-secondary py-4">
              <div class="spinner-border spinner-border-sm me-2" role="status"></div>Ładowanie formularza płatności…
            </div>

            <div id="checkout-container"></div>

            <p class="text-secondary small mt-3 mb-0">
              <i class="bi bi-shield-lock me-1"></i>Płatność obsługuje Stripe (BLIK, Przelewy24, karta).
              Plik pobierzesz od razu po potwierdzeniu płatności.
            </p>
          </div>

          <!-- Widok wyniku (po zamknięciu płatności zostajemy w tym samym modalu) -->
          <div id="checkout-result" class="d-none">
            <div id="result-pending" class="text-center py-4 d-none">
              <div class="spinner-border text-primary" role="status"></div>
              <h2 class="h6 mt-3 mb-1">Czekamy na potwierdzenie płatności</h2>
              <p class="text-secondary small mb-0">Potwierdź płatność w aplikacji banku — ten widok odświeży się sam.</p>
            </div>

            <div id="result-paid" class="d-none">
              <div class="text-center mb-4">
                <i class="bi bi-check-circle-fill text-success" style="font-size:2.5rem"></i>
                <h2 class="h5 mt-2 mb-0">Płatność potwierdzona</h2>
              </div>

              <dl class="row small mb-3">
                <dt class="col-sm-5 text-secondary fw-normal">Numer zamówienia (do reklamacji)</dt>
                <dd class="col-sm-7"><code id="result-payment-intent">—</code></dd>
              </dl>

              <div class="d-grid mb-3">
                <a href="#" class="btn btn-primary btn-lg" id="result-download-btn">
                  <i class="bi bi-download me-2"></i>Pobierz plik
                </a>
              </div>

              <label class="form-label small text-secondary mb-1">Link do pobrania (możesz go skopiować i zachować)</label>
              <div class="input-group input-group-sm mb-2">
                <input type="text" class="form-control font-monospace" id="result-link" readonly>
                <button class="btn btn-outline-secondary" type="button" id="result-copy-btn">
                  <i class="bi bi-clipboard me-1"></i>Kopiuj
                </button>
              </div>
              <p class="text-secondary small mb-2">Link działa przez 24 godziny od zakupu (do 10 pobrań).
                Potwierdzenie wysłaliśmy też na Twój e-mail.</p>
              <p class="text-secondary small mb-0">
                <i class="bi bi-info-circle me-1"></i>Plik wyłącznie do użytku własnego (bez edycji,
                upubliczniania i odsprzedaży). Rozpoczęcie pobierania oznacza utratę prawa odstąpienia.
                Reklamacje: <a href="mailto:<%= seller.email %>"><%= seller.email %></a> z numerem zamówienia.
              </p>
            </div>

            <div id="result-failed" class="d-none text-center py-4">
              <i class="bi bi-x-circle-fill text-danger" style="font-size:2.5rem"></i>
              <h2 class="h5 mt-2 mb-1">Płatność nie doszła do skutku</h2>
              <p class="text-secondary small mb-0">Nie pobraliśmy żadnych środków. Zamknij to okno i spróbuj ponownie.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%- include('partials/footer') %>

  <script src="/vendor/bootstrap/bootstrap.bundle.min.js"></script>
  <script src="https://js.stripe.com/v3/"></script>
  <script>
    window.BDIK_STRIPE = {
      publishableKey: <%- JSON.stringify(stripePublishableKey || '') %>,
      configured: <%- JSON.stringify(Boolean(stripeConfigured)) %>,
    };
  </script>
  <script src="/js/checkout.js"></script>
  <script src="/js/table.js"></script>
  <script src="/js/cookies.js"></script>
</body>
</html>
