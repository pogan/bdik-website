<!doctype html>
<html lang="pl">
<head>
  <%- include('partials/head', { title: 'Płatność - Baza Instytucji Kultury' }) %>
</head>
<body>
  <%- include('partials/nav', { user: typeof user !== 'undefined' ? user : null }) %>

  <main class="container pb-5">
    <div class="row justify-content-center">
      <div class="col-12 col-md-8 col-lg-6">
        <% if (!order) { %>
          <div class="card">
            <div class="card-body text-center py-5">
              <i class="bi bi-question-circle text-secondary" style="font-size:2.5rem"></i>
              <h1 class="h5 mt-3">Nie znaleziono zamówienia</h1>
              <p class="text-secondary">Link jest nieprawidłowy lub zamówienie zostało usunięte.</p>
              <a href="/baza" class="btn btn-primary">Wróć do bazy</a>
            </div>
          </div>
        <% } else { %>
          <div class="card" id="order-card" data-token="<%= order.token %>" data-status="<%= order.status %>">
            <div class="card-body text-center py-5">
              <div id="state-paid" class="<%= order.status === 'paid' ? '' : 'd-none' %>">
                <i class="bi bi-check-circle-fill text-success" style="font-size:2.5rem"></i>
                <h1 class="h5 mt-3">Płatność potwierdzona</h1>
                <p class="text-secondary mb-4">
                  <%= order.formatLabel %> · <%= order.rowCount %> instytucji · <%= order.amountLabel %>
                </p>
                <a href="<%= order.downloadUrl || '#' %>" class="btn btn-primary btn-lg" id="download-btn">
                  <i class="bi bi-download me-2"></i>Pobierz plik
                </a>
                <p class="text-secondary small mt-3 mb-0">
                  Link działa przez 7 dni. Zachowaj go, jeśli chcesz pobrać plik ponownie.
                </p>
              </div>

              <div id="state-pending" class="<%= order.status === 'pending' ? '' : 'd-none' %>">
                <div class="spinner-border text-primary" role="status"></div>
                <h1 class="h5 mt-3">Czekamy na potwierdzenie płatności</h1>
                <p class="text-secondary mb-0">
                  Potwierdź płatność w aplikacji banku. Ta strona odświeży się sama.
                </p>
              </div>

              <div id="state-failed" class="<%= order.status === 'failed' || order.status === 'expired' ? '' : 'd-none' %>">
                <i class="bi bi-x-circle-fill text-danger" style="font-size:2.5rem"></i>
                <h1 class="h5 mt-3">Płatność nie doszła do skutku</h1>
                <p class="text-secondary mb-4">Nie pobraliśmy żadnych środków. Możesz spróbować ponownie.</p>
                <a href="/baza" class="btn btn-primary">Wróć do bazy</a>
              </div>
            </div>
          </div>
        <% } %>
      </div>
    </div>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/platnosc.js"></script>
</body>
</html>
