<!doctype html>
<html lang="pl">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/nav', { user: typeof user !== 'undefined' ? user : null }) %>

  <main class="container pb-5">
    <div class="row justify-content-center">
      <div class="col-12 col-lg-9">
        <nav aria-label="breadcrumb">
          <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/baza">Baza</a></li>
            <li class="breadcrumb-item active" aria-current="page">Poradniki</li>
          </ol>
        </nav>

        <h1 class="h3 mb-1">Poradniki</h1>
        <p class="text-secondary mb-4">
          Praktyczne wskazówki dla artystów, zespołów i animatorów kultury, którzy chcą
          współpracować z domami kultury, centrami kultury i bibliotekami.
        </p>

        <div class="list-group">
          <% guides.forEach((g) => { %>
            <a class="list-group-item list-group-item-action py-3" href="/poradniki/<%= g.slug %>">
              <div class="fw-semibold"><%= g.title %></div>
              <div class="small text-secondary"><%= g.description %></div>
            </a>
          <% }) %>
        </div>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>

  <script src="/vendor/bootstrap/bootstrap.bundle.min.js"></script>
  <script src="/js/cookies.js"></script>
</body>
</html>
