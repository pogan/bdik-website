<!doctype html>
<html lang="pl">
<head>
  <%- include('partials/head', { title: 'Brak dostępu' }) %>
</head>
<body>
  <%- include('partials/nav', { user: typeof user !== 'undefined' ? user : null }) %>

  <main class="container pb-5">
    <div class="row justify-content-center">
      <div class="col-12 col-md-8 col-lg-6">
        <div class="card">
          <div class="card-body text-center py-5">
            <i class="bi bi-shield-lock text-secondary" style="font-size:2.5rem"></i>
            <h1 class="h5 mt-3">Panel tylko dla administratora</h1>
            <p class="text-secondary mb-4">
              <% if (user) { %>
                Konto <strong><%= user.email %></strong> nie ma uprawnień administratora.
              <% } else { %>
                Zaloguj się kontem administratora, aby zobaczyć zamówienia.
              <% } %>
            </p>
            <a href="/baza" class="btn btn-primary">Wróć do bazy</a>
          </div>
        </div>
      </div>
    </div>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
