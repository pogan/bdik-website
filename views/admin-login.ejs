<!doctype html>
<html lang="pl">
<head>
  <%- include('partials/head', { title: 'Logowanie administratora' }) %>
</head>
<body>
  <%- include('partials/nav', { user: typeof user !== 'undefined' ? user : null }) %>

  <main class="container pb-5">
    <div class="row justify-content-center">
      <div class="col-12 col-md-8 col-lg-6">
        <div class="card">
          <div class="card-body text-center py-5">
            <i class="bi bi-shield-lock text-secondary" style="font-size:2.5rem"></i>
            <h1 class="h5 mt-3">Panel administratora</h1>
            <p class="text-secondary mb-4">
              Ta część serwisu jest dostępna wyłącznie dla administratora.
              Zaloguj się kontem administratora, aby przejść do panelu.
            </p>
            <% if (loginFailed) { %>
              <div class="alert alert-danger" role="alert">
                Logowanie nie powiodło się. Konto nie ma uprawnień administratora.
              </div>
            <% } %>
            <a href="/auth/google" class="btn btn-primary">
              <i class="bi bi-google me-1"></i>Zaloguj się przez Google
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>

  <script src="/vendor/bootstrap/bootstrap.bundle.min.js"></script>
  <script src="/js/cookies.js"></script>
</body>
</html>
