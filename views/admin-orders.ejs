<!doctype html>
<html lang="pl">
<head>
  <%- include('partials/head', { title: 'Zamówienia - panel administratora' }) %>
</head>
<body>
  <%- include('partials/nav', { user: typeof user !== 'undefined' ? user : null }) %>

  <% const shownCount = status ? orders.filter((o) => o.status === status).length : orders.length; %>
  <main class="container pb-5">
    <div class="d-flex flex-wrap justify-content-between align-items-end mb-3 gap-2">
      <div>
        <h1 class="h4 mb-1">Zamówienia</h1>
        <p class="text-secondary small mb-0"><span id="orders-count"><%= status ? `${shownCount} z ${totalCount}` : totalCount %></span> zamówień · link klienta ważny <%= ttlHours %> godz. (do <%= maxDownloads %> pobrań)</p>
      </div>
      <a href="/baza" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Do bazy</a>
    </div>

    <nav id="status-filter" class="d-flex flex-wrap gap-2 mb-3" aria-label="Filtr statusu zamówienia">
      <a href="/admin/orders" data-status="" class="btn btn-sm <%= status ? 'btn-outline-secondary' : 'btn-secondary' %>"<%- status ? '' : ' aria-current="page"' %>>
        wszystkie <span class="badge text-bg-light ms-1"><%= totalCount %></span>
      </a>
      <% statusFilters.forEach((f) => { %>
        <a href="/admin/orders?status=<%= f.value %>" data-status="<%= f.value %>" class="btn btn-sm <%= status === f.value ? 'btn-secondary' : 'btn-outline-secondary' %>"<%- status === f.value ? ' aria-current="page"' : '' %>>
          <%= f.label %> <span class="badge text-bg-light ms-1"><%= f.count %></span>
        </a>
      <% }); %>
    </nav>

    <% if (sourceSummary.length) { %>
      <details class="mb-3 small">
        <summary class="fw-semibold">Opłacone zamówienia według źródła (<%= sourceSummary.length %>)</summary>
        <table class="table table-sm mt-2 mb-1 bg-white border" style="max-width:640px">
          <thead><tr><th>Kampania / źródło</th><th class="text-end">Zamówień</th><th class="text-end">Brutto przed rabatem</th></tr></thead>
          <tbody>
            <% sourceSummary.forEach((s) => { %>
              <tr><td><%= s.source %></td><td class="text-end"><%= s.count %></td><td class="text-end"><%= s.grossLabel %></td></tr>
            <% }) %>
          </tbody>
        </table>
        <div class="text-secondary">Źródło = ostatnie wejście z kampanii (UTM) albo z innej strony w ciągu 30 dni przed zamówieniem, dopasowane do statystyk odwiedzin bez ciasteczek. Zmiana sieci lub przeglądarki = „(bez źródła)”.</div>
      </details>
    <% } %>

    <% if (!orders.length) { %>
      <div class="card"><div class="card-body text-center text-secondary py-5">Brak zamówień.</div></div>
    <% } else { %>
      <div id="orders-empty" class="card<%= shownCount ? ' d-none' : '' %>"><div class="card-body text-center text-secondary py-5">Brak zamówień o tym statusie.</div></div>
      <div id="orders-table" class="table-responsive bg-white border rounded<%= shownCount ? '' : ' d-none' %>">
        <table class="table table-hover align-middle mb-0 small">
          <thead>
            <tr>
              <th>Data</th>
              <th>Status</th>
              <th>Identyfikator transakcji</th>
              <th>Zakres</th>
              <th class="text-end">Kwota brutto</th>
              <th>E-mail / dane do faktury</th>
              <th>Źródło</th>
              <th class="text-end">Pobrań</th>
              <th class="text-end">Plik</th>
            </tr>
          </thead>
          <tbody>
            <% orders.forEach((o) => { %>
              <tr data-status="<%= o.status %>"<%- status && o.status !== status ? ' class="d-none"' : '' %>>
                <td class="text-nowrap text-secondary"><%= o.createdAt %></td>
                <td>
                  <% if (o.status === 'paid') { %>
                    <span class="badge text-bg-success">opłacone</span>
                  <% } else if (o.status === 'pending') { %>
                    <span class="badge text-bg-warning">oczekuje</span>
                  <% } else if (o.status === 'failed') { %>
                    <span class="badge text-bg-danger">nieudane</span>
                  <% } else if (o.status === 'expired') { %>
                    <span class="badge text-bg-secondary">wygasłe</span>
                  <% } else { %>
                    <span class="badge text-bg-secondary"><%= o.status %></span>
                  <% } %>
                </td>
                <td>
                  <% if (o.identifier) { %>
                    <code class="user-select-all"><%= o.identifier %></code>
                  <% } else { %>
                    <span class="text-secondary" title="Brak numeru transakcji Stripe (nieopłacone lub sprzed integracji)">—</span>
                  <% } %>
                </td>
                <td>
                  <span class="fw-semibold"><%= o.formatLabel %> · <%= o.rowCount %></span>
                  <div class="text-secondary"><%= o.description %></div>
                </td>
                <td class="text-end text-nowrap">
                  <%= o.amountLabel %>
                  <div class="text-secondary" style="font-size:.75rem">netto <%= o.netLabel %> + VAT <%= o.vatLabel %></div>
                </td>
                <td>
                  <div class="text-nowrap"><%= o.email || '—' %></div>
                  <% if (o.billingTaxId) { %>
                    <div class="text-secondary" style="font-size:.75rem">NIP: <span class="user-select-all"><%= o.billingTaxId %></span></div>
                  <% } %>
                  <% if (o.billingName) { %>
                    <div class="text-secondary" style="font-size:.75rem"><%= o.billingName %></div>
                  <% } %>
                  <% if (o.billingAddress) { %>
                    <div class="text-secondary" style="font-size:.75rem"><%= o.billingAddress %></div>
                  <% } %>
                </td>
                <td><% if (o.source) { %><%= o.source %><% } else { %><span class="text-secondary">—</span><% } %></td>
                <td class="text-end"><%= o.downloadCount %></td>
                <td class="text-end text-nowrap">
                  <% if (o.backupUrl) { %>
                    <a href="<%= o.backupUrl %>" class="btn btn-sm btn-primary">
                      <i class="bi bi-download me-1"></i>Backup
                    </a>
                    <% if (!o.publicActive) { %>
                      <div class="text-secondary mt-1" style="font-size:.75rem">link klienta wygasł</div>
                    <% } %>
                  <% } else { %>
                    <span class="text-secondary">—</span>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <p class="text-secondary small mt-3 mb-0">
        <i class="bi bi-info-circle me-1"></i>Backup pobierasz bez limitu i bez wygasania. Link klienta (<code>/pobierz/pi_…</code>) działa <%= ttlHours %> godz. od opłacenia.
      </p>
    <% } %>
  </main>

  <%- include('partials/footer') %>

  <script src="/vendor/bootstrap/bootstrap.bundle.min.js"></script>
  <script src="/js/cookies.js"></script>
  <script src="/js/admin-orders.js"></script>
</body>
</html>
