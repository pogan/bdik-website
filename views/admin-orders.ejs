<!doctype html>
<html lang="pl">
<head>
  <%- include('partials/head', { title: 'Zamówienia - panel administratora' }) %>
</head>
<body>
  <%- include('partials/nav', { user: typeof user !== 'undefined' ? user : null }) %>

  <main class="container pb-5">
    <div class="d-flex flex-wrap justify-content-between align-items-end mb-3 gap-2">
      <div>
        <h1 class="h4 mb-1">Zamówienia</h1>
        <p class="text-secondary small mb-0"><%= orders.length %> zamówień · link klienta ważny <%= ttlHours %> godz. (do <%= maxDownloads %> pobrań)</p>
      </div>
      <a href="/baza" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Do bazy</a>
    </div>

    <% if (!orders.length) { %>
      <div class="card"><div class="card-body text-center text-secondary py-5">Brak zamówień.</div></div>
    <% } else { %>
      <div class="table-responsive bg-white border rounded">
        <table class="table table-hover align-middle mb-0 small">
          <thead>
            <tr>
              <th>Data</th>
              <th>Status</th>
              <th>Identyfikator transakcji</th>
              <th>Zakres</th>
              <th class="text-end">Kwota</th>
              <th>E-mail</th>
              <th class="text-end">Pobrań</th>
              <th class="text-end">Plik</th>
            </tr>
          </thead>
          <tbody>
            <% orders.forEach((o) => { %>
              <tr>
                <td class="text-nowrap text-secondary"><%= o.createdAt %></td>
                <td>
                  <% if (o.status === 'paid') { %>
                    <span class="badge text-bg-success">opłacone</span>
                  <% } else if (o.status === 'pending') { %>
                    <span class="badge text-bg-warning">oczekuje</span>
                  <% } else if (o.status === 'failed') { %>
                    <span class="badge text-bg-danger">nieudane</span>
                  <% } else { %>
                    <span class="badge text-bg-secondary"><%= o.status %></span>
                  <% } %>
                </td>
                <td>
                  <% if (o.identifier) { %>
                    <code class="user-select-all"><%= o.identifier %></code>
                  <% } else { %>
                    <span class="text-secondary" title="Brak numeru transakcji Stripe (nieopłacone lub sprzed integracji)">—</span>
                  <% } %>
                </td>
                <td>
                  <span class="fw-semibold"><%= o.formatLabel %> · <%= o.rowCount %></span>
                  <div class="text-secondary"><%= o.description %></div>
                </td>
                <td class="text-end text-nowrap"><%= o.amountLabel %></td>
                <td class="text-nowrap"><%= o.email || '—' %></td>
                <td class="text-end"><%= o.downloadCount %></td>
                <td class="text-end text-nowrap">
                  <% if (o.backupUrl) { %>
                    <a href="<%= o.backupUrl %>" class="btn btn-sm btn-primary">
                      <i class="bi bi-download me-1"></i>Backup
                    </a>
                    <% if (!o.publicActive) { %>
                      <div class="text-secondary mt-1" style="font-size:.75rem">link klienta wygasł</div>
                    <% } %>
                  <% } else { %>
                    <span class="text-secondary">—</span>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <p class="text-secondary small mt-3 mb-0">
        <i class="bi bi-info-circle me-1"></i>Backup pobierasz bez limitu i bez wygasania. Link klienta (<code>/pobierz/pi_…</code>) działa <%= ttlHours %> godz. od opłacenia.
      </p>
    <% } %>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
